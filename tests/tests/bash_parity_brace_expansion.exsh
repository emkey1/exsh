#!/usr/bin/env exsh
d="${TMPDIR:-/tmp}/exsh_parity_brace.$$"
mkdir -p "$d" || exit 1
cd "$d" || exit 1

show() { echo "$# $(printf '[%s]' "$@")"; }

echo foo{a,b}
echo {1..3}
for i in {1..3}; do echo $i; done
echo {a..c}
echo {3..1} {c..a}
echo a{b,c{d,e}}f
echo x{1,2}y{3,4}z
echo a{,b}
echo a{b}c {} {,} a{b
echo "a{b,c}" 'a{b,c}' a\{b,c\}
x=1; echo {$x,2} a{$x,y}
n=3; echo {1..$n}
show {"a b",c}
a=({1..3}); echo ${#a[@]}
x={a,b}; echo $x
mkdir -p t/{x,y}; ls t
echo {$(echo a),b}
touch f1 f2; echo {f*,z}
x=1; echo ${x}{a,b}
{echo,b}
echo {-1..1}
echo {A..C} {x..z} {0..2}
echo {a.b} {a..} {..a}
x=1; echo ${x}a{b,c}
echo {a\,b,c}
echo /nonexistent{1,2}/*
for w in {"a b","c d"}; do echo "[$w]"; done
echo {1..1000} | wc -w | tr -d ' '
{ echo group; }
{ echo a; echo b; } | cat
echo a}
echo }

# set +B turns it off.
set +B; echo foo{a,b}; set -B; echo foo{a,b}

cd /
rm -rf "$d"
