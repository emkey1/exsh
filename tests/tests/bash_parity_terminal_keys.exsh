#!/usr/bin/env exsh
# A script on a terminal: its commands share the group the terminal knows, so they may read and set
# the terminal, and a key reaches them and the shell. They used to get a background group: `cat`,
# `stty` and `x=$(cat)` stopped for good, Ctrl-C left the command running, and an EXIT trap was lost.
# Host only: this takes a real pty, a real signal and programs on PATH. Stop forms are in
# bash_parity_group_signal: here the shell leads its session, where the kernel drops a stop.
command -v python3 > /dev/null 2>&1 || exit 77
perl -e 'exit 0' 2> /dev/null || exit 77
set -- $(ps -o args= -p $$)
d="${TMPDIR:-/tmp}/exsh-terminal-keys.$$"
rm -rf "$d"
mkdir -p "$d"
cat > "$d/keys.py" <<'PY'
import os, pty, re, select, signal, sys, time
C = b"\x03"
CATCH = "perl -e '$SIG{INT}=sub{print \"caught\\n\"; exit 7}; sleep 5; exit 0'"
FORMS = [
    ("child", "echo up\nsleep 5\necho no\n", [("up", C)]),
    ("pipeline", "echo up\nsleep 5 | cat\necho no\n", [("up", C)]),
    ("loop", "echo up\nfor i in 1 2 3; do sleep 5; echo no; done\necho no2\n", [("up", C)]),
    ("subshell", "echo up\n( sleep 5; echo no1 )\necho no2\n", [("up", C)]),
    ("function", "f() { sleep 5; echo no1; }\necho up\nf\necho no2\n", [("up", C)]),
    ("substitution", "echo up\nx=$(sleep 5; echo y)\necho \"no [$x]\"\n", [("up", C)]),
    ("source", "echo 'sleep 5; echo no1' > f\necho up\n. ./f\necho no2\n", [("up", C)]),
    ("eval", "echo up\neval 'sleep 5; echo no1'\necho no2\n", [("up", C)]),
    ("exit_trap", "trap 'echo bye' EXIT\necho up\nsleep 5\necho no\n", [("up", C)]),
    ("exit_trap_source", "trap 'echo bye' EXIT\necho 'sleep 5; echo no1' > f\necho up\n. ./f\necho no2\n", [("up", C)]),
    ("exit_trap_exit", "trap 'echo bye; exit 5' EXIT\necho up\nsleep 5\necho no\n", [("up", C)]),
    ("int_trap", "trap 'echo int' INT\necho up\nsleep 5\necho \"next $?\"\n", [("up", C)]),
    ("child_catches", "echo up\n" + CATCH + "\necho \"next $?\"\n", [("up", C)]),
    ("child_catches_trap", "trap 'echo int' INT\necho up\n" + CATCH + "\necho \"next $?\"\n", [("up", C)]),
    ("subshell_child_catches", "echo up\n( " + CATCH + "; echo \"in $?\" )\necho \"next $?\"\n", [("up", C)]),
    ("substitution_child_catches", "echo up\nx=$(" + CATCH + ")\necho \"next $? [$x]\"\n", [("up", C)]),
    ("child_ignores", "echo up\nperl -e '$SIG{INT}=\"IGNORE\"; sleep 1; print \"done\\n\"; exit 3'\necho \"next $?\"\n", [("up", C)]),
    ("ignored_inherited", "trap '' INT\necho up\nperl -e 'print \"[$SIG{INT}]\\n\"; sleep 1; exit 3'\necho \"next $?\"\n", [("up", C)]),
    ("job_ignores", "perl -e 'print \"[$SIG{INT}][$SIG{QUIT}]\\n\"' &\nwait\n", []),
    ("cat_reads", "echo up\ncat\necho \"cat $?\"\n", [("up", b"abc\n"), ("abc", b"\x04")]),
    ("read_builtin", "echo up\nread x\necho \"got [$x]\"\n", [("up", b"abc\n")]),
    ("read_interrupted", "echo up\nread x\necho no\n", [("up", C)]),
    ("read_interrupted_trap", "trap 'echo int' INT\necho up\nread x\necho \"next $? [$x]\"\n", [("up", C), ("int", b"abc\n")]),
    ("stty", "echo up\nstty -echo\necho \"stty $?\"\nstty echo\necho \"stty $?\"\n", []),
    ("foreground_group", "perl -e 'use POSIX; print \"fg \", (POSIX::tcgetpgrp(0) == getpgrp() ? \"mine\" : \"other\"), \"\\n\"'\n", []),
    ("substitution_reads", "echo up\nx=$(cat)\necho \"got [$x]\"\n", [("up", b"abc\n\x04")]),
    ("pipeline_reads", "echo up\ncat | tr a-z A-Z\necho \"rc $?\"\n", [("up", b"abc\n\x04")]),
    ("job_has_no_terminal", "cat > j &\nj=$!\necho up\nsleep 0.3\nwait $j\necho \"job $? [$(cat j)]\"\n", [("up", b"typed\n")]),
]
def drain(fd, t):
    out = b""
    while select.select([fd], [], [], t)[0]:
        try:
            b = os.read(fd, 4096)
        except OSError:
            break
        if not b:
            break
        out += b
    return out
def one(shell, base, name, text, keys):
    d = os.path.join(base, name)
    os.mkdir(d)
    with open(os.path.join(d, "s"), "w") as f:
        f.write(text)
    pid, fd = pty.fork()
    if pid == 0:
        for s in (signal.SIGINT, signal.SIGQUIT, signal.SIGTERM):
            signal.signal(s, signal.SIG_DFL)
        os.environ["TERM"] = "dumb"
        os.chdir(d)
        os.execv(shell, [shell, "s"])
    out = b""
    keys = list(keys)
    seen = 0
    t0 = time.time()
    rc = "HANG"
    while time.time() - t0 < 3:
        out += drain(fd, 0.02)
        if keys and keys[0][0].encode() in out[seen:]:
            seen = len(out)
            time.sleep(0.15)
            os.write(fd, keys.pop(0)[1])
        p, st = os.waitpid(pid, os.WNOHANG)
        if p:
            out += drain(fd, 0.05)
            rc = os.WEXITSTATUS(st) if os.WIFEXITED(st) else -os.WTERMSIG(st)
            pid = 0
            break
    if pid:
        os.kill(pid, signal.SIGKILL)
        os.waitpid(pid, 0)
    os.close(fd)
    os.system("pkill -9 -f %s > /dev/null 2>&1" % d)
    text = out.decode(errors="replace")
    text = re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", text).replace("\r\n", "|").replace("\n", "|").replace("\r", "|")
    return rc, text
for name, text, keys in FORMS:
    rc, out = one(sys.argv[1], sys.argv[2], name, text, keys)
    print("%s rc=%s [%s]" % (name, rc, out), flush=True)
PY
python3 "$d/keys.py" "$1" "$d"
rm -rf "$d"
