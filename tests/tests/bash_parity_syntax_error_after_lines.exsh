#!/usr/bin/env exsh
# The lines before a syntax error run, the same line as it does not, and an EXIT trap runs after
# the message. Bash reads a line at a time, and exsh parses the whole text first but runs the same.
trap 'echo "exit trap"' EXIT
f() { echo "in f"; }
f
echo one; echo two
echo three;
if true; then
  echo four
fi
for x in a b; do
  echo "$x"
done
echo not this; ( echo nor this ) b
echo nor this
