#!/usr/bin/env exsh
# A command substitution puts back the stdout it found. On iOS a body's redirection moves
# only its vproc slot 1, and the substitution rebuilt that slot from the host's fd 1: what
# came after it left the redirection and went to the real stdout.
d="${TMPDIR:-/tmp}/exsh_parity_sub_keeps.$$"
mkdir -p "$d" || exit 1
f="$d/f"

show() {
    echo "$1: [$(cat "$f")]"
    rm -f "$f"
}

( x=$(echo a); echo "$x" ) > "$f"; show subshell
( echo before; x=$(echo a); echo "$x"; y=$(echo b); echo "$y" ) > "$f"; show "before and after"
( x=$(y=$(echo in); echo "$y"); echo "$x" ) > "$f"; show nested
( ( x=$(echo a); echo "$x" ) ) > "$f"; show "subshell in a subshell"
( ( x=$(echo a); echo "$x" ) > "$f"; y=$(echo after); echo "$y" ); show "inner redirection"
{ x=$(echo a); echo "$x"; } > "$f"; show group
( { x=$(echo a); echo "$x"; } > "$f" ); show "group in a subshell"
if true; then x=$(echo a); echo "$x"; fi > "$f"; show if
for i in 1 2; do x=$(echo "$i"); echo "$x"; done > "$f"; show for
n=0; while [ "$n" -lt 2 ]; do x=$(echo "$n"); echo "$x"; n=$((n+1)); done > "$f"; show while
case a in a) x=$(echo a); echo "$x" ;; esac > "$f"; show case
p() { x=$(echo a); echo "$x"; }
p > "$f"; show function
( p ) > "$f"; show "function in a subshell"

# exec moves the slot too, and keeps it moved.
( exec > "$f"; x=$(echo a); echo "$x"; y=$(echo b); echo "$y" ); show "exec in a subshell"
exec 3>&1
exec > "$f"; x=$(echo a); echo "$x"
exec 1>&3 3>&-
show "exec at the top"

# What the substitution does to its own stdout stays in there.
( x=$(exec > "$d/g"; echo inner); echo "[$x] $(cat "$d/g")"; rm -f "$d/g" ) > "$f"; show "exec inside"

# A pipe is a slot as well.
echo a | { x=$(cat); echo "$x"; } > "$f"; show "piped group"
( x=$(echo a); echo "$x" ) | cat > "$f"; show "stage writes to a pipe"
( x=$(echo a); echo "$x" ) | { y=$(cat); echo "[$y]"; } > "$f"; show "both sides"

# The other descriptors were never touched, and must keep working next to it.
( x=$(echo a); echo "$x" >&2 ) 2> "$f"; show stderr
( x=$(echo a); echo "$x"; echo e >&2 ) > "$f" 2>&1; show merged
( exec 4> "$f"; x=$(echo a); echo "$x" >&4; exec 4>&- ); show "descriptor 4"

# Read from it, and append to it, after the substitution.
( echo one; x=$(echo two); echo "$x" ) > "$f"; ( x=$(echo three); echo "$x" ) >> "$f"; show append

# Sourced, backgrounded, many in a row, and bigger than a pipe.
printf 'x=$(echo a)\necho "$x"\n' > "$d/s"
. "$d/s" > "$f"; show source
( . "$d/s" ) > "$f"; show "source in a subshell"
( x=$(echo a); echo "$x" ) > "$f" &
wait $!; show background
( n=0; while [ "$n" -lt 200 ]; do x=$(echo "$n"); n=$((n+1)); done; echo "$x" ) > "$f"; show many
( x=$(seq 1 30000); echo "${#x}"; unset x ) > "$f"; show big

# And the shell's own stdout is still what it was.
x=$(echo end); echo "$x"

cd / && rm -rf "$d"
