#!/usr/bin/env exsh
# Replacing stdin left the old descriptor open on iOS, 2 for each `cat < f` and 3 in a pipeline
# stage, so a loop stopped when none were left, after about 116 rounds at a limit of 256. Builtins
# leak the same and fork nothing, so they make up the count: the harness allows 20 s for a test.
d="${TMPDIR:-/tmp}/exsh_parity_stdinloop.$$"
mkdir -p "$d" || exit 1
cd "$d" || exit 1
echo x > f

i=0
while [ "$i" -lt 150 ]; do read l < f || break; i=$((i + 1)); done
echo "builtin $i $l"

i=0
while [ "$i" -lt 150 ]; do { read l; } < f || break; i=$((i + 1)); done
echo "group $i"

i=0
while [ "$i" -lt 150 ]; do while read l; do :; done < f; i=$((i + 1)); done
echo "loop $i"

i=0
while [ "$i" -lt 30 ]; do cat < f > /dev/null || break; i=$((i + 1)); done
echo "command $i"

i=0
while [ "$i" -lt 90 ]; do cat < f | cat > /dev/null || break; i=$((i + 1)); done
echo "stage $i"

# With stdin already a file, and what it was still there after each round.
{
  i=0
  while [ "$i" -lt 150 ]; do read m < f || break; i=$((i + 1)); done
  echo "inside $i"
  read l
  echo "still $l"
} < f

cd /
rm -rf "$d"
