#!/usr/bin/env exsh
# What bash 4 and 5 added. bash 3.2 has none of these, so they have expected output of their
# own instead of a comparison.
x=abc; echo ${x^} ${x^^}
x=ABC; echo ${x,} ${x,,}
x=abc; echo ${x^^[ab]}
a=(ab cd); echo "${a[@]^^}"
x=abcdef; echo ${x:1:-1}
a=(x y z); echo ${a[-1]} ${a[-2]}
echo {01..03}
case a in a) echo 1;& b) echo 2;; c) echo 3;; esac
case a in a) echo 1;;& a) echo 2;; c) echo 3;; esac
case a in b) echo 1;;& a) echo 2;& c) echo 3;;& d) echo 4;; esac
x=1; [[ -v x ]] && echo set; [[ -v nosuch ]] || echo unset
declare -A m; m[k]=v; m[j]="x y"; echo "${m[k]}" "${m[j]}" ${#m[@]}
declare -A n=([a]=1 [b]=2); echo "${n[a]}${n[b]}"
k=a; n[$k]=9; echo "${n[$k]}" "${n[a]}"
declare -l lo; lo=ABC; echo $lo; declare -u up; up=abc; echo $up
x="it's"; echo "${x@Q}"
echo {1..9..2} {10..1..3}
x=$(case a in a) echo y;; esac); echo "$x"
echo $(("1"+1))
echo $((1 ? 2 : 1/0)) $((0 && 1/0)) $((1 || 1/0))
(echo $((2**-1)); echo no) 2>/dev/null; echo "status $?"
read -t 0 x < /dev/null; echo $?
readonly ro=1; (echo $((ro=2)); echo no) 2>/dev/null; echo "status $?"
[[ abc == @(abc|def) ]] && echo y; [[ abc == !(x) ]] && echo z; [[ aaa == +(a) ]] && echo w; [[ b == ?(a)b ]] && echo v; [[ aab == *(a)b ]] && echo u
shopt -s extglob; d="${TMPDIR:-/tmp}/exsh_extglob.$$"; mkdir -p "$d"; cd "$d"; touch a.c a.h b.c; echo @(a|b).c; echo !(a).c; echo +(a).?; x=abc; case $x in @(abc|def)) echo yes;; esac; cd /; rm -rf "$d"
[ -n "$BASH_VERSION" ] && [ "${BASH_VERSINFO[0]}" -ge 4 ] && echo versioned
(sleep 0.5; exit 3) & (exit 5) & wait -n; echo $?; wait -n; echo $?; wait -n; echo $?
(exit 4) & (exit 4) & sleep 0.3; wait -n; echo $?; wait -n; echo $?; wait -n; echo $?
(exit 6) & sleep 0.2; wait; (exit 7) & wait -n; echo $?; wait -n; echo $?
(sleep 0.2; exit 8) & wait; (exit 9) & wait -n; echo $?
(exit 3) & a=$!; sleep 0.2; wait $a; echo $?; wait -n; echo $?
(exit 3) & a=$!; (exit 4) & sleep 0.2; wait $a; wait -n; echo $?; wait -n; echo $?; wait $a; echo $?
b=([5]=x); unset b; declare -A b; b[k]=v; b[j]=w; echo "${b[k]} ${b[j]}"
k() { case b in b) return 4;; esac; }; case a in a) k; echo one;;& a) echo two;; esac
# declare -p with no names (bash 3.2 prints nothing), a local's value, what has none yet.
f() { local v=1; local -i n=2; n=n+1; echo "$n"; declare -p | grep -E '^declare [-a-zA-Z]+ (v|n)(=|$)'; }; f
export pe; declare -p | grep -E '^declare [-a-zA-Z]+ pe(=|$)'; unset pe
gv=g; f() { local gv=l; declare -p | grep -E '^declare [-a-zA-Z]+ gv(=|$)'; }; f; declare -p | grep -E '^declare [-a-zA-Z]+ gv(=|$)'
f() { local lv; declare -p lv; declare -p | grep -E '^declare [-a-zA-Z]+ lv(=|$)'; }; f
f() { local lx=1; export lx; declare -p | grep -E '^declare [-a-zA-Z]+ lx(=|$)'; }; f
f() { local a=1 b='x y'; local; }; f
f() { local n; echo "[${n-unset}] [${n:-e}] [${#n}]"; }; f
f() { local v=1; unset v; declare -p v; echo "rc=$?"; }; f
# 3.2 expands this one before the prefix before it.
A=1 B=${A:-d} sh -c 'echo "$B"'; unset A
declare -A sa; f() { local sa=1; declare -p sa; env | grep -c '^sa='; }; f; sa[k]=v; echo "${sa[k]}"
(exit 3) & sleep 0.1; x=$(wait -n 2>/dev/null; echo "in $?"); echo "[$x]"; wait -n; echo "out $?"
sleep 0.2 & x=$(sleep 0 & wait -n; echo "in $?"); echo "[$x]"; wait; echo "out $?"
# The numbers: 3.2 gives 255, 1 and 128 for the bad arguments, and goes by the failed command in an ERR trap.
f() { return abc; echo no; }; f 2>/dev/null; echo "return word $?"
return 2>/dev/null; echo "return outside $?"
eval return 2>/dev/null; echo "eval return outside $?"
(while :; do break abc; done) 2>/dev/null; echo "break word $?"
f() { return 1 2; echo no; }
f 2>/dev/null; echo no
echo "too many $?"
(f() { trap 'return' ERR; (exit 5); echo no; }; f; echo "bare return in ERR $?")
(f() { trap 'echo x; return' ERR; (exit 6); echo no; }; f; echo "bare return after a command $?")
(f() { trap 'return 8' ERR; false; echo no; }; f; echo "number in ERR $?")
(f() { trap 'return 2' ERR; (( 0 )); echo no; }; f; echo "arithmetic in ERR $?")
(set -E; k() { false; echo no; }; f() { trap 'return 7' ERR; k; echo no; }; f; echo "nested with -E $?")
(trap 'echo r1' RETURN; f() { trap 'echo r2' RETURN; }; f; . /dev/null; echo "a function's own stays")
time -- echo dashes 2>/dev/null
printf '%S|%C|\n' abc def
vset=1; [ -v vset ]; echo "[ -v ] $?"; [ -v vnone ]; echo "[ -v ] $?"; test -v vset; echo "test -v $?"; [ -v '' ]; echo "[ -v ] $?"; [ -v '#' ]; echo "[ -v ] $?"; [[ -v '' ]]; echo "[[ -v ]] $?"; [ x = x -a -z ]; echo "last word $?"
# {name}> f: the shell picks a descriptor from 10 up, and it stays until the script closes it.
d="${TMPDIR:-/tmp}/exsh_fdvar.$$"; rm -rf "$d"; mkdir -p "$d"; cd "$d"
exec {fd}> /dev/null; echo "ok ${fd:+set}"; [ "$fd" -ge 10 ] && echo high; exec {fd}>&-
exec {fd}> f; echo hi >&$fd; exec {fd}>&-; cat f
echo a > f; exec {fd}< f; read l <&$fd; echo "[$l]"; exec {fd}<&-
exec {a}> /dev/null {b}> /dev/null; [ "$a" != "$b" ] && echo differ; exec {a}>&- {b}>&-
exec {a}> /dev/null; exec {a}>&-; exec {b}> /dev/null; [ "$a" = "$b" ] && echo reused; exec {b}>&-
echo a > f; exec {fd}>> f; echo b >&$fd; exec {fd}>&-; cat f
echo a > f; exec {fd}<> f; read l <&$fd; echo "[$l]"; exec {fd}>&-
exec {fd}>&1; echo viadup >&$fd; exec {fd}>&-
echo a > f; exec 3< f; exec {fd}<&3; read l <&$fd; echo "[$l]"; exec {fd}<&- 3<&-
exec {fd}<<'END'
line
END
read l <&$fd; echo "[$l]"; exec {fd}<&-
exec {fd}<<< text; read l <&$fd; echo "[$l]"; exec {fd}<&-
(set -C; exec {fd}>| f; echo b >&$fd; exec {fd}>&-; cat f)
declare -a arr; exec {arr[2]}> /dev/null; echo "ok ${arr[2]:+set} ${!arr[@]}"; exec {arr[2]}>&-
declare -A kv; exec {kv[k]}> /dev/null; [ -n "${kv[k]}" ] && echo keyed; exec {kv[k]}>&-
i=1; ix=(); exec {ix[i+1]}> /dev/null; echo "${!ix[@]}"; exec {ix[i+1]}>&-
exec {fd}< <(echo procsub); read l <&$fd; echo "[$l]"; exec {fd}<&-
X=1 exec {fd}> /dev/null; echo "prefix ${fd:+set} [${X:-}]"; exec {fd}>&-
# What only looks like one.
(exec {1}> /dev/null; echo no) 2>/dev/null; echo "digit $?"
(exec {a-b}> /dev/null; echo no) 2>/dev/null; echo "not a name $?"
(exec {}> /dev/null; echo no) 2>/dev/null; echo "empty $?"
(exec {a*}> /dev/null; echo no) 2>/dev/null; echo "star $?"
({fd} > /dev/null; echo "space $?") 2>/dev/null
("{fd}"> /dev/null; echo "quoted $?") 2>/dev/null
echo a{fd}> f; cat f
eval 'echo a > {fd}> f' 2>/dev/null || echo "not a target"
# What fails.
(readonly fd=1; exec {fd}> /dev/null; echo "readonly $? $fd") 2>/dev/null
(unset fd; exec {fd}>&-; echo "unset $?") 2>/dev/null
(fd=-3; exec {fd}>&-; echo "negative $?") 2>/dev/null
(fd=77; exec {fd}>&-; echo "not open $?") 2>/dev/null
(unset fd; exec {fd}< missing.in; echo "no file $? [${fd:-none}]") 2>/dev/null
(unset fd; exec {fd}>&7; echo "closed source $? [${fd:-none}]") 2>/dev/null
(unset fd; echo x {fd}< missing.in; echo "on a builtin $? [${fd:-none}]") 2>/dev/null
# On any command that stays in the shell.
unset fd; echo line > f; read l {fd}< f; echo "[$l] ${fd:+set}"; read m <&$fd; echo "[$m]"; exec {fd}<&-
unset fd; echo x {fd}> f; echo y >&$fd; exec {fd}>&-; cat f
unset fd; { echo in; } {fd}> f; echo out >&$fd; exec {fd}>&-; cat f
unset fd; fn() { :; }; fn {fd}> f; echo y >&$fd; exec {fd}>&-; cat f
unset fd; while :; do break; done {fd}> f; echo y >&$fd; exec {fd}>&-; cat f
unset fd; command true {fd}> /dev/null; echo "command ${fd:+set}"; exec {fd}>&-
unset fd; A=1 true {fd}> /dev/null; echo "prefix ${fd:+set}"; exec {fd}>&-
# dash on Linux cannot name a descriptor above 9, and iOS has no /dev/fd.
(exec {fd}> f; if [ -e /dev/fd/0 ]; then sh -c "cat > /dev/fd/$fd" <<< child; else sh -c "echo child >&$fd"; fi; exec {fd}>&-; cat f)
(exec {fd}> f; true {fd}>&-; echo back >&$fd; exec {fd}>&-; cat f)
(exec {fd}> f; ls . >&$fd; exec {fd}>&-; [ -s f ] && echo wrote)
(exec {fd}>&2; exec {fd}>&-; echo closed >&$fd; echo "closed $?") 2>/dev/null
(exec 10>&2; exec 10>&-; echo closed >&10; echo "ten closed $?") 2>/dev/null
eval 'exec {fd}> f'; echo in >&$fd; eval 'exec {fd}>&-'; cat f; unset fd
echo 'exec {fd}> f' > s; . ./s; echo in >&$fd; exec {fd}>&-; cat f; unset fd
for n in 1 2 3; do exec {fd}> "g$n"; echo "$n" >&$fd; exec {fd}>&-; done; cat g1 g2 g3; unset fd
(exec {fd}> f; for n in 1 2; do echo "$n" >&$fd; done; exec {fd}>&-; cat f)
echo a > f; (exec {fd}< f; while read l <&$fd; do echo "[$l]"; done; exec {fd}<&-)
# With no command it makes the file and leaves nothing.
(unset fd; {fd}> made; [ -e made ] && echo made; echo "[${fd:-none}]")
(exec {fd}> f; {fd}>&-; echo open >&$fd; echo "still open $?"; exec {fd}>&-; cat f)
# What is a process of its own under bash keeps it there.
unset fd; x=$(exec {fd}> /dev/null; echo "${fd:+set}"); echo "[$x] [${fd:-none}]"
( exec {fd}> /dev/null; echo "${fd:+set}" ); echo "[${fd:-none}]"
f2() { local fd; exec {fd}> /dev/null; echo "${fd:+set}"; exec {fd}>&-; }; f2; echo "[${fd:-none}]"
f2() { exec {fd}> /dev/null; }; f2; echo "${fd:+set}"; exec {fd}>&-; unset fd
exec {fd}> /dev/null | cat; echo "[${fd:-none}]"
true {fd}> /dev/null & wait; echo "[${fd:-none}]"
true | echo x {fd}> /dev/null; echo "[${fd:-none}]"
( echo a > f; cat {fd}< f > /dev/null; echo "[${fd:-none}]" )
{ echo a >&$fd; } {fd}> g | cat; echo "[${fd:-none}]"; cat g
true | { echo b >&$fd; } {fd}> g; echo "[${fd:-none}]"; cat g
{ echo c >&$fd; } {fd}> g & wait; echo "[${fd:-none}]"; cat g
x=$(exec {fd}> /dev/null; echo "$fd"); ( : >&$x ) 2>/dev/null; echo "gone with it $?"
x=$(echo y {fd}> g; echo z >&$fd; echo "$fd"); ( : >&$x ) 2>/dev/null; echo "gone with it $?"; cat g
x=$({ echo y; } {fd}> g; echo w >&$fd; echo "$fd"); ( : >&$x ) 2>/dev/null; echo "gone with it $?"; cat g
x=$(exec {fd}> g; echo v >&$fd; exec {fd}>&-; echo "$fd"); ( : >&$x ) 2>/dev/null; echo "closed in it $?"; cat g
x=$(y=$(exec {fd}> g; echo "$fd"); ( : >&$y ) 2>/dev/null; echo "nested $?"); echo "[$x]"
(exec {fd}> g true; echo no); echo "replaced $?"
cd /; rm -rf "$d"
# wait -n in a substitution: what the shell started is no child of its own. Bash finds it has no
# child, calls them all ended and gives 0 for each, at once.
( sleep 0.3 & x=$(wait -n; echo "rc $?"); echo "[$x]" )
( sleep 0.3 & x=$(wait -n; echo "rc $?"; wait -n; echo "rc $?"); echo "[$x]" )
( sleep 0.3 & sleep 0.3 & x=$(wait -n; echo "rc $?"; wait -n; echo "rc $?"; wait -n; echo "rc $?"); echo "[$x]" )
( sleep 0.5 & x=$(( exit 4 ) & wait -n; echo "rc $?"; wait -n; echo "rc $?"; wait -n; echo "rc $?"); echo "[$x]" )
( ( exit 3 ) & sleep 0.2; x=$(wait -n; echo "rc $?"); echo "[$x]"; wait -n; echo "after $?" )
( ( sleep 0.2; exit 6 ) & x=$(wait -n; echo "rc $?"); echo "[$x]"; wait -n; echo "after $?" )
( sleep 0.3 & x=$(y=$(wait -n; echo "in $?"); echo "$y"; wait -n; echo "out $?"); echo "[$x]" )
( sleep 0.3 & x=$(wait -n; jobs > /dev/null; jobs; echo "listed"); echo "[$x]" )
( sleep 5 & p=$!; x=$(wait -n; echo "rc $?"); echo "[$x]"; kill $p; wait $p; echo "still its own $?" ) 2>/dev/null
( sleep 5 & x=$(wait -n; kill %1 2>/dev/null; echo "kill $?"); echo "[$x]"; kill %1; wait; echo "done" ) 2>/dev/null
( sleep 0.2 & x=$(wait -n; wait; echo "rc $?"); echo "[$x]" )
( sleep 0.2 & x=$(eval 'wait -n; echo "rc $?"'); echo "[$x]" )
( fw() { wait -n; echo "rc $?"; }; sleep 0.2 & x=$(fw); echo "[$x]" )
( sleep 0.2 & x=$({ wait -n; echo "rc $?"; } 2>&1); echo "[$x]" )
( sleep 0.2 | sleep 0.2 & x=$(wait -n; echo "rc $?"; wait -n; echo "rc $?"); echo "[$x]" )
( sleep 0.2 & disown; x=$(wait -n; echo "rc $?"); echo "disowned [$x]" )
( x=$(wait -n; echo "rc $?"); echo "none [$x]" )
sleep 0.2 & ( wait -n; echo "a subshell has none $?" ); wait
sleep 0.2 & ( x=$(wait -n; echo "rc $?"); echo "nor one inside it [$x]" ); wait
sleep 0.2 & x=$(echo a | { wait -n; echo "rc $?"; }); echo "nor a stage [$x]"; wait
unset a b fd v
# wait -n with operands, and wait's options.
( ( exit 3 ) & p=$!; ( sleep 0.2; exit 4 ) & q=$!; wait -n $q; echo "named $?"; wait $p; echo "other $?" )
( ( sleep 0.3; exit 3 ) & p=$!; ( sleep 0.1; exit 4 ) & q=$!; wait -n $p $q; echo "first of two $?" )
( ( sleep 0.1; exit 5 ) & sleep 0.3 & wait -n %1; echo "by job $?" )
( ( sleep 0.1; exit 7 ) & q=$!; wait -n 99999 $q 2>/dev/null; echo "past an unknown $?" )
( ( sleep 0.1; exit 7 ) & q=$!; wait -n %9 abc $q 2>/dev/null; echo "past bad ones $?" )
( wait -n 99999 2>/dev/null; echo "unknown $?"; wait -n abc 2>/dev/null; echo "not a number $?"; wait -n %9 2>/dev/null; echo "no job $?" )
( ( exit 12 ) & q=$!; wait -n -- $q; echo "dashes $?"; wait --; echo "bare dashes $?" )
( ( sleep 0.1; exit 8 ) & q=$!; wait -n -p v; r=$?; [ "$v" = "$q" ]; echo "-p $r $?" )
( ( sleep 0.1; exit 8 ) & q=$!; wait -n -p v $q; r=$?; [ "$v" = "$q" ]; echo "-p named $r $?" )
( ( exit 9 ) & q=$!; wait -p v $q; r=$?; [ "$v" = "$q" ]; echo "-p plain $r $?" )
( ( exit 9 ) & q=$!; wait -p v %1; r=$?; [ "$v" = "$q" ]; echo "-p job $r $?" )
( ( exit 9 ) & q=$!; wait -np v $q; r=$?; [ "$v" = "$q" ]; echo "-np $r $?" )
( v=x; wait -n -p v; echo "-p none $? [${v-unset}]"; v=x; wait -p v; echo "-p bare $? [${v-unset}]" )
( ( exit 10 ) & q=$!; wait -f $q; echo "-f $?"; ( exit 10 ) & q=$!; wait -fn $q; echo "-fn $?" )
( wait -x 2>/dev/null; echo "bad option $?"; wait -p 2>/dev/null; echo "no name $?" )
( ( exit 3 ) & wait -p 1x %1 2>/dev/null; echo "bad name $?"; readonly v=1; wait -n -p v 2>/dev/null; echo "readonly $?"; wait %1; echo "left $?" )
# The redirections before a word have acted when it expands.
d=${TMPDIR:-/tmp}/exsh_fdv2.$$; rm -rf "$d"; mkdir -p "$d"; cd "$d" || exit 1
( exec {a}> f {b}>&$a; echo x >&$b; echo "[${a:+set}] [${b:+set}]"; cat f; [ "$a" != "$b" ]; echo "two $?" )
( echo x {a}> g >&$a; echo "[${a:+set}]"; cat g )
( sh -c 'echo prog' {a}> g >&$a; echo "[${a:-none}]"; cat g )
( sh -c 'echo job' {a}> g >&$a & wait; echo "[${a:-none}]"; cat g )
( sh -c 'echo stage' {a}> g >&$a | cat; echo "[${a:-none}]"; cat g )
( f3() { echo "in [${a:+set}]" >&2; echo out; }; f3 {a}> g >&$a; cat g; echo "after [${a:+set}]" )
( a=keep; sh -c 'echo was' {a}> g >&$a; echo "[$a]"; cat g )
( exec {a}> g {b}< g; [ -n "$b" ]; echo "read side $?" )
( : {a}> g > ${nope:?bad} 2>/dev/null; echo "not reached" ) 2>/dev/null; echo "failed word $?"
# command prog: a process has the name and the descriptor, under bash, and they go with it.
( command sh -c 'exit 0' {fd}> g; echo "[${fd:-none}]"; ( : >&10 ) 2>/dev/null; echo "closed $?" )
( command -p sh -c 'exit 0' {fd}> g; echo "[${fd:-none}]"; ( : >&10 ) 2>/dev/null; echo "closed $?" )
( command command sh -c 'exit 0' {fd}> g; echo "[${fd:-none}]"; ( : >&10 ) 2>/dev/null; echo "closed $?" )
( command nosuchprog {fd}> g 2>/dev/null; echo "$? [${fd:-none}]"; ( : >&10 ) 2>/dev/null; echo "closed $?" )
( f4() { :; }; command f4 {fd}> g 2>/dev/null; echo "$? [${fd:-none}]" )
( command sh -c 'echo x' {a}> g >&$a; echo "[${a:-none}]"; cat g )
( command echo x {fd}> g > /dev/null; echo "[${fd:+set}]"; ( : >&$fd ) 2>/dev/null; echo "stays $?" )
( command -v sh {fd}> g > /dev/null; echo "[${fd:+set}]" )
# What a function sees of a name given to it as a job or a stage, and the shell does not.
( f5() { echo "[${fd:+set}]"; echo x >&$fd; }; f5 {fd}> g & wait; echo "[${fd:-none}]"; cat g )
( f5() { echo "[${fd:+set}]"; echo y >&$fd; }; f5 {fd}> g | cat; echo "[${fd:-none}]"; cat g )
( f5() { echo "[${fd:+set}]"; echo z >&$fd; }; : | f5 {fd}> g; echo "[${fd:-none}]"; cat g )
( f5() { echo "[${fd:+set}]"; }; : | f5 {fd}> g | cat; echo "[${fd:-none}]" )
( eval 'echo "[${fd:+set}]"' {fd}> g & wait; echo "[${fd:-none}]" )
( eval 'echo "[${fd:+set}]"' {fd}> g | cat; echo "[${fd:-none}]" )
( echo 'echo "[${fd:+set}]"' > s; . ./s {fd}> g | cat; echo "[${fd:-none}]" )
( f6() { echo "[${a[1]:+set}]"; }; f6 {a[1]}> g & wait; echo "[${a[1]:-none}]" )
# shopt varredir_close: the descriptor goes with the command, and the name stays. Not for exec.
( shopt varredir_close > /dev/null; echo "off $?"; shopt -q varredir_close; echo "-q $?"; shopt -s varredir_close; shopt -q varredir_close; echo "on $?"; shopt -u varredir_close; shopt -q varredir_close; echo "off again $?" )
( shopt -p varredir_close )
( shopt -s varredir_close; { echo a >&$a; } {a}> g; cat g; echo "[${a:+set}]"; ( : >&$a ) 2>/dev/null; echo "closed $?" )
( shopt -s varredir_close; echo x {a}> g > /dev/null; echo "[${a:+set}]"; ( : >&$a ) 2>/dev/null; echo "closed $?" )
( shopt -s varredir_close; f7() { echo b >&$a; }; f7 {a}> g; cat g; echo "[${a:+set}]"; ( : >&$a ) 2>/dev/null; echo "closed $?" )
( shopt -s varredir_close; exec {a}> g; echo c >&$a; cat g; ( : >&$a ) 2>/dev/null; echo "open $?" )
( shopt -s varredir_close; sh -c 'exit 0' {a}> g; echo "[${a:-none}]" )
cd /; rm -rf "$d"
# A process substitution sees the shell's jobs as copies, as a command substitution does.
( sleep 0.2 & cat <(wait -n; echo "procsub $?") )
( sleep 0.2 & sleep 0.2 & cat <(wait -n; echo "procsub $?"; wait -n; echo "procsub $?"; wait -n; echo "procsub $?") )
( cat <(wait -n; echo "none $?") )
( cat <(( exit 4 ) & wait -n; echo "own $?") )
( sleep 0.2 & cat <(wait -n %1 2>/dev/null; echo "by job $?") )
( sleep 0.2 & q=$!; x=$(wait -n $q 2>/dev/null; echo "named in a substitution $?"); echo "$x"; wait $q; echo "still its own $?" )
# Bash 5 stops where the words do not make one name, and rejects these before they run.
( set -- a b; a=1; b=2; echo "[${!@}]"; echo "not reached" ) 2>/dev/null; echo "two names $?"
( set -- a b; a=1; b=2; echo "[${!*}]"; echo "not reached" ) 2>/dev/null; echo "two names $?"
( set -- 1a; echo "[${!@}]"; echo "not reached" ) 2>/dev/null; echo "not a name $?"
( set -- ''; echo "[${!@}]"; echo "not reached" ) 2>/dev/null; echo "empty $?"
( set -- a; a='x y'; echo "[${!@@Q}] [${!*@Q}]" )
eval '[[ {a}>b ]]' 2>/dev/null; [ $? -gt 1 ] && echo "name rejected"
eval '[[ {a[1]}<b ]]' 2>/dev/null; [ $? -gt 1 ] && echo "element rejected"
# [[ > ]] collates, so this compares in C order whatever the locale.
( LC_ALL=C; [[ {a} > b ]]; echo "spaced $?" )

# What arithmetic names when it fails, where 3.2 names something else or takes it differently.
unset x y a n
arith() { ( eval "$1" ) 2>&1 | sed -e 's/^.*line [0-9]*: //' -e 's/arithmetic syntax error/syntax error/'; }
arith 'echo $((1/0+1))'
arith 'echo $(( 1 / 0 ))'
arith 'echo $((  1  /  0  ))'
arith 'echo $((1/(0)))'
arith 'echo $((1/(2-2)+3))'
arith 'echo $((1/-0))'
arith 'echo $((1/!1))'
arith 'echo $((1/0/2))'
arith 'echo $((1%0%2))'
arith 'x=0; echo $((1/x+1))'
arith 'echo $((1?1/0:2))'
arith 'echo $((1/0,2))'
arith 'a[0]=0; echo $((1/a[0]))'
arith 'a[0]=0; echo $((1/a[0]+1))'
arith 'echo $((1/0 1))'
arith 'echo $((1/0?1:2))'
arith 'echo $((1/
0))'
arith 'echo $((1/ 
 0))'
