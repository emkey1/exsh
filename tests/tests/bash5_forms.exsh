#!/usr/bin/env exsh
# What bash 4 and 5 added. bash 3.2 has none of these, so they have expected output of their
# own instead of a comparison.
x=abc; echo ${x^} ${x^^}
x=ABC; echo ${x,} ${x,,}
x=abc; echo ${x^^[ab]}
a=(ab cd); echo "${a[@]^^}"
x=abcdef; echo ${x:1:-1}
a=(x y z); echo ${a[-1]} ${a[-2]}
echo {01..03}
case a in a) echo 1;& b) echo 2;; c) echo 3;; esac
case a in a) echo 1;;& a) echo 2;; c) echo 3;; esac
case a in b) echo 1;;& a) echo 2;& c) echo 3;;& d) echo 4;; esac
x=1; [[ -v x ]] && echo set; [[ -v nosuch ]] || echo unset
declare -A m; m[k]=v; m[j]="x y"; echo "${m[k]}" "${m[j]}" ${#m[@]}
declare -A n=([a]=1 [b]=2); echo "${n[a]}${n[b]}"
k=a; n[$k]=9; echo "${n[$k]}" "${n[a]}"
declare -l lo; lo=ABC; echo $lo; declare -u up; up=abc; echo $up
x="it's"; echo "${x@Q}"
echo {1..9..2} {10..1..3}
x=$(case a in a) echo y;; esac); echo "$x"
echo $(("1"+1))
echo $((1 ? 2 : 1/0)) $((0 && 1/0)) $((1 || 1/0))
(echo $((2**-1)); echo no) 2>/dev/null; echo "status $?"
read -t 0 x < /dev/null; echo $?
readonly ro=1; (echo $((ro=2)); echo no) 2>/dev/null; echo "status $?"
[[ abc == @(abc|def) ]] && echo y; [[ abc == !(x) ]] && echo z; [[ aaa == +(a) ]] && echo w; [[ b == ?(a)b ]] && echo v; [[ aab == *(a)b ]] && echo u
shopt -s extglob; d="${TMPDIR:-/tmp}/exsh_extglob.$$"; mkdir -p "$d"; cd "$d"; touch a.c a.h b.c; echo @(a|b).c; echo !(a).c; echo +(a).?; x=abc; case $x in @(abc|def)) echo yes;; esac; cd /; rm -rf "$d"
[ -n "$BASH_VERSION" ] && [ "${BASH_VERSINFO[0]}" -ge 4 ] && echo versioned
(sleep 0.5; exit 3) & (exit 5) & wait -n; echo $?; wait -n; echo $?; wait -n; echo $?
(exit 4) & (exit 4) & sleep 0.3; wait -n; echo $?; wait -n; echo $?; wait -n; echo $?
(exit 6) & sleep 0.2; wait; (exit 7) & wait -n; echo $?; wait -n; echo $?
(sleep 0.2; exit 8) & wait; (exit 9) & wait -n; echo $?
b=([5]=x); unset b; declare -A b; b[k]=v; b[j]=w; echo "${b[k]} ${b[j]}"
