))'
arith 'a=(1 2); echo ${a[ 1 / 0 ]}'
arith 'x=abc; echo ${x: 1 / 0 }'
arith 'a=(1 2); echo ${a[0]:1/0}'
arith "declare -i n; n=' 1 / 0 '"
arith 'echo $((1+ ))'
arith 'echo $(( 1 + ))'
arith 'echo $((1**))'
arith 'echo $((x+=))'
arith 'echo $((x<<=))'
arith 'echo $((1<<))'
arith 'echo $((1<=))'
arith 'echo $((1&&))'
arith 'echo $((1||))'
arith 'echo $((x= ))'
arith 'echo $((1 == ))'
arith 'echo $((1 ? ))'
arith 'echo $((1?2: ))'
arith 'echo $((1 ? 2 ))'
arith 'echo $(( 2 ** -1 ))'
arith 'echo $((- ))'
