arith 'echo $((1 -- ))'
arith 'echo $((1**2**))'
arith 'echo $((2#))'
arith 'echo $((16#))'
arith 'echo $(("1/0"))'
arith 'echo $(("1"2)) $((1"+"2))'
arith 'echo $(("1+"))'
arith '(("1/0"))'
arith 'echo $((" 1 / 0 "))'
arith 'echo $(( "1" + "2" ))'
arith 'x=abc; echo ${x:"1/0"}'
arith 'a=(1 2); echo ${a["1/0"]}'
arith "x='\"1\"'; echo \$(( \"\$x\" ))"
arith 'echo $((x+y=2))'
arith 'echo $((-x=2))'
arith 'echo $((++x++))'
arith 'echo $((--x++))'
arith 'echo $((++x--))'
arith 'echo $((++x++y))'
(set -u; ((nosuch)); echo no) 2>/dev/null; echo "set -u (( $?"
(set -u; let nosuch; echo no) 2>/dev/null; echo "set -u let $?"
(set -u; echo $((nosuch)); echo no) 2>/dev/null; echo "set -u word $?"
(set -u; for ((i=nosuch;;)); do break; done; echo no) 2>/dev/null; echo "set -u for $?"
(set -u; [[ nosuch -eq 0 ]]; echo no) 2>/dev/null; echo "set -u test $?"
(readonly r=1; ((r=2)); echo "readonly (( $?") 2>/dev/null
(readonly r=1; let r=2; echo "readonly let $?") 2>/dev/null
(readonly r=1; echo $((r=2)); echo no) 2>/dev/null; echo "readonly word $?"
(set -e; ((1/0)); echo no) 2>/dev/null; echo "set -e $?"
(trap 'echo err' ERR; ((1/0)); echo "ERR (( $?") 2>/dev/null
(trap 'echo err' ERR; let 1/0; echo "ERR let $?") 2>/dev/null
(trap 'echo err' ERR; [[ 1/0 -eq 1 ]]; echo "ERR test $?") 2>/dev/null
declare -A keyed=([1+1]=x [k]=y); echo "${keyed[1+1]} ${keyed[k]}"
# 3.2 keeps the listing only for a bare `jobs`, and gives 1 for a word.
( sleep 0.4 & command jobs | wc -l | tr -d ' '; wait )
caller abc 2>/dev/null; echo "caller word $?"
# 3.2 differs on all of these.
( ulimit -Sn 100; ulimit -Hn 300; ulimit -Hn )
ulimit -n '' 2>/dev/null; echo "ulimit empty $?"
ulimit -n -1 2>/dev/null; echo "ulimit negative $?"
ulimit -Q 2>/dev/null; echo "ulimit option $?"
ulimit -p 5 2>/dev/null; echo "ulimit pipe $?"
ulimit -p > /dev/null; echo "ulimit pipe read $?"
b5=${TMPDIR:-/tmp}/b5bin.$$
printf 'ab\0c\n' > "$b5"; chmod +x "$b5"; ( exec "$b5" ) 2>/dev/null; echo "exec binary $?"; rm -f "$b5"
# 3.2 reports a job that a signal ended as it goes, and keeps a job after `jobs`.
b5gone() { while kill -0 "$1" 2>/dev/null; do sleep 0.02; done; }
( sleep 9 & p=$!; kill -TERM $p; b5gone $p; jobs | sed -E 's/\[1\][-+ ] +//; s/Terminated[: 0-9]* */Terminated /; s/ .*sleep.*/ sleep/' ) 2>/dev/null
( true & b5gone $!; jobs %1 > /dev/null; echo "rc=$?"; jobs %1 2>/dev/null; echo "rc=$?" )
( sleep 9 & a=$!; sleep 9 & b=$!; jobs %sleep 2>/dev/null; echo "ambiguous $?"; wait %sleep 2>/dev/null; echo "ambiguous $?"; kill %sleep 2>/dev/null; echo "ambiguous $?"; disown %sleep 2>/dev/null; echo "ambiguous $?"; kill $a $b; wait ) 2>/dev/null
( sleep 9 & p=$!; jobs 1 > /dev/null 2>&1; echo "listed $?"; jobs sleep > /dev/null 2>&1; echo "listed $?"; jobs $p > /dev/null 2>&1; echo "not a pid $?"; kill $p; wait ) 2>/dev/null
( true & b5gone $!; jobs > /dev/null; wait %1 2>&1 | sed 's/.*: //' ) 2>&1
( true & b5gone $!; jobs > /dev/null; wait %1 2>/dev/null; echo "waited $?" )
# A bare wait right after kill has not heard of it. Bash's answer is a race it nearly always wins, so it is fixed here.
( sleep 9 & kill %1; wait; sleep 9 & p=$!; jobs | sed -E 's/  +/ /g'; kill $p; wait ) 2>/dev/null
( sleep 9 & a=$!; kill $a; wait; sleep 9 & p=$!; jobs | sed -E 's/  +/ /g'; kill $p; wait ) 2>/dev/null
# A job's arguments leave `$_` alone, and $BASHPID in its words is the job. 3.2 empties the one and has not the other.
echo a; true b & echo "[$_]"; wait
echo a; true $(echo b) & echo "[$_]"; wait
echo a; true b | cat; echo "[$_]"
f="${TMPDIR:-/tmp}/exsh_bash5_jobpid.$$"
echo $BASHPID > "$f" & p=$!; wait; [ "$(cat "$f")" = "$p" ] && echo "its own"
echo $BASHPID $(true) > "$f" & p=$!; wait; [ "$(cat "$f")" = "$p " ] || [ "$(cat "$f")" = "$p" ] && echo "its own"
rm -f "$f"
# What a positional is called depends on the braces.
(set -u; echo $1) 2>&1 | sed -e 's/.*: \(.*\): unbound variable/\1/'
(set -u; echo ${1}) 2>&1 | sed -e 's/.*: \(.*\): unbound variable/\1/'
