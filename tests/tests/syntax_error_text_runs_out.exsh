#!/usr/bin/env exsh
# Text that ends inside something is an error, and a here-document simply ends with it. The name
# and line in front differ with what is reading, so they go: what is left is the same on 3.2 and 5.3
# as far as it goes.
d="${TMPDIR:-/tmp}/exsh_syntax_runs_out.$$"
rm -rf "$d"
mkdir -p "$d" || exit 1
t() {
  eval "$1" > "$d/out" 2>&1
  st=$?
  printf '%s status %s\n' "$(sed -e 's/^.*: line [0-9]*: //' "$d/out")" "$st"
}
t 'if true'
t 'while true; do'
t 'for x in a; do :'
t '{'
t '( :'
t 'case x in'
t 'a |'
t 'function f'
t 'echo "a'
t "echo 'a"
t 'echo `a'
t 'echo $(a'
t 'echo ${a'
t 'echo $((1'
t 'x=(1 2'
t 'cat <<E'
t 'cat <<E
body'
echo still running
cd /
rm -rf "$d"
