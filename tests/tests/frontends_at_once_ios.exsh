#!/bin/sh
# On iOS a pipeline's stages and a terminal's tabs are threads of one process, and a frontend's
# compile state was process-wide, so two frontends at once crashed the app or reported each
# other's names as undefined or redefined. Each program declares variables and routines, or it
# hides: a program with no names has nothing to collide.
echo "frontends-at-once:start"
d="${TMPDIR:-/tmp}/exsh_frontends_at_once.$$"
mkdir -p "$d" || exit 1
cd "$d" || exit 1

pad=""
n=1
while [ "$n" -le 40 ]; do pad="$pad p$n"; n=$((n + 1)); done
{ printf 'program V;\ntype TR = record x: integer; end;\nvar i: integer; s: string; b: boolean; r: TR;\n'
  for f in $pad; do printf 'function %s(a: integer): integer;\nvar q: integer;\nbegin\n  q := a + 1;\n  %s := q;\nend;\n' "$f" "$f"; done
  printf "begin\n  s := 'abc'; b := true; i := p3(2); r.x := i;\n  writeln('pascal ', r.x, ' ', s[1], ' ', b);\nend.\n"; } > v.pas
{ printf 'program X;\nvar j: integer; i: real; b: boolean;\n'
  for f in $pad; do printf 'function %s(a: integer): integer;\nvar q: integer;\nbegin\n  q := a + 2;\n  %s := q;\nend;\n' "$f" "$f"; done
  printf "begin\n  j := p4(2); b := false;\n  writeln('pascal2 ', j, ' ', b);\nend.\n"; } > x.pas
{ printf 'struct P { int x; };\nint g = 5;\nconst int K = 7;\n'
  for f in $pad; do printf 'int %s(int a) { int q; q = a + 1; return q; }\n' "$f"; done
  printf 'int main() {\n    int i;\n    struct P* p;\n    new(&p);\n    p->x = p3(2);\n    i = p->x;\n    printf("clike %%d %%d %%d\\n", i, g, K);\n    dispose(&p);\n    return 0;\n}\n'; } > v.clike
{ printf 'struct Q { int y; int z; };\nint g = 9;\nconst int K = 8;\n'
  for f in $pad; do printf 'int %s(int a) { int q; q = a + 2; return q; }\n' "$f"; done
  printf 'int main() {\n    int i;\n    struct Q* p;\n    new(&p);\n    p->z = p4(2);\n    i = p->z;\n    printf("clike2 %%d %%d %%d\\n", i, g, K);\n    dispose(&p);\n    return 0;\n}\n'; } > x.clike
{ for f in $pad; do printf 'int %s(int a) { int q = a + 1; return q; }\n' "$f"; done
  printf 'class C { int v; int get() { return my.v; } }\nint i = 3;\nC c = new C();\nc.v = p3(2);\nwriteln("rea ", c.get(), " ", i, " ", true);\n'; } > v.rea
{ for f in $pad; do printf 'int %s(int a) { int q = a + 2; return q; }\n' "$f"; done
  printf 'class D { int w; int two() { return my.w * 2; } }\nint i = 4;\nD d = new D();\nd.w = p2(0);\nwriteln("rea2 ", d.two(), " ", i, " ", false);\n'; } > x.rea

# check NAME WANT COMMAND: stderr is part of what must match. One run each: the harness allows a
# test 20 seconds, and on the old code nearly every one of these failed the first time.
check() {
    name=$1; want=$2; shift 2
    got=$(eval "$*" 2>&1)
    if [ "$got" = "$want" ]; then
        echo "$name ok"
    else
        echo "$name: $got"
    fi
}
nl='
'
P="pascal --no-cache"; C="clike --no-cache"; R="rea --no-cache"
PV="pascal 3 a TRUE"; PX="pascal2 4 FALSE"; CV="clike 3 5 7"; CX="clike2 4 9 8"; RV="rea 3 3 true"; RX="rea2 4 4 false"

check clike_clike "$CX" "$C v.clike | $C x.clike"
check rea_rea "$RX" "$R v.rea | $R x.rea"
check pascal_pascal "$PX" "$P v.pas | $P x.pas"
check clike_pascal "$PX" "$C v.clike | $P x.pas"
check pascal_clike "$CX" "$P v.pas | $C x.clike"
check rea_clike "$CX" "$R v.rea | $C x.clike"
check pascal_rea "$RX" "$P v.pas | $R x.rea"

# The first stage's output has to get through as well.
check clike_both "$CX$nl$CV" "$C v.clike | { $C x.clike; cat; }"
check rea_both "$RX$nl$RV" "$R v.rea | { $R x.rea; cat; }"
check pascal_both "$PX$nl$PV" "$P v.pas | { $P x.pas; cat; }"

# Background jobs are what two tabs look like from the frontends' side. Their stderr goes aside
# because a background tool announces itself there on this build; the output still has to match.
check background "$CV$nl$PV$nl$RV" "{ $C v.clike & $P v.pas & $R v.rea & wait; } 2>/dev/null | sort"
# One printf, one write: clike's used to go out a byte at a time and interleave mid-line. Byte
# order, since a language's collation on Linux ignores the space and puts clike2 first.
check background_same "$CV$nl$CV$nl$CX$nl$CX" "{ $C v.clike & $C x.clike & $C v.clike & $C x.clike & wait; } 2>/dev/null | LC_ALL=C sort"

# A compile error stays in its own stage. The count of them was process-wide.
printf 'program Bad;\nvar i: integer;\nbegin\n  i := undefinedname + 1;\nend.\n' > bad.pas
check bad_pascal "$PX" "$P bad.pas 2>/dev/null | $P x.pas"

# One new source, one cache entry, two writers.
cp v.clike fresh1.clike
check cache_writers "$CV" "clike fresh1.clike | clike fresh1.clike"

cd /
rm -rf "$d"
echo "frontends-at-once:end"
