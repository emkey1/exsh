#!/usr/bin/env exsh
# exec with only redirections keeps them. Opening could land right on the descriptor
# asked for, and closing the source then undid it, so `exec 3> f` left 3 closed.
# Host only: on the iOS-flavoured build `exec 3< f; read x <&3` reads nothing, before and after.
d="${TMPDIR:-/tmp}/exsh_parity_exec_redir.$$"
mkdir -p "$d" || exit 1
cd "$d" || exit 1
: > not_executable
( exec ./not_executable; echo not-reached ) 2>/dev/null; echo "not executable rc=$?"
exec 3> f; echo x >&3; exec 3>&-; cat f
echo a > f; exec 4< f; read x <&4; exec 4<&-; echo "$x"
exec 3> a 4> b; echo 1 >&3; echo 2 >&4; exec 3>&- 4>&-; cat a b
echo x 3> f >&3; cat f
{ echo x >&3; } 3> f; cat f
sh -c 'echo x >&3' 3> f; cat f
exec 3>&1; echo x >&3; exec 3>&-; echo y
cd /
rm -rf "$d"
