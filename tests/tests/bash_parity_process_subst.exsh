#!/usr/bin/env exsh
d="${TMPDIR:-/tmp}/exsh_parity_procsub.$$"
mkdir -p "$d" || exit 1
cd "$d" || exit 1

cat <(echo a)
cat <(echo a) <(echo b)
diff <(echo a) <(echo a); echo $?
diff <(echo a) <(echo b) > /dev/null; echo $?
while read l; do echo "[$l]"; done < <(printf 'x\ny\n')
read v < <(echo from); echo "$v"
x=$(cat <(echo inner)); echo "$x"
v=1; cat <(echo "$v"); f() { echo fn; }; cat <(f)
cat <(cat <(echo nested))
echo a > >(cat > out); sleep 1; cat out
echo "<(echo a)"
echo '<(echo a)'
[ -e <(echo a) ] && echo exists
wc -l < <(seq 1 3) | tr -d ' '
for f in <(echo l); do cat "$f"; done

cd /
rm -rf "$d"
