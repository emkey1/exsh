#!/usr/bin/env exsh
# Only + - * / % worked in $(( )). The rest stayed in the output as text with status 0.
echo $((1+2*3)) $(( (1+2)*3 )) $((7/2)) $((7%3)) $((2**3)) $((-1)) $((!0)) $((~0)) $((-2**2)) $((2**3**2))
echo $((1<2)) $((2>3)) $((1==1)) $((1!=1)) $((1<=1)) $((2>=3)) $((1&&0)) $((1||0))
echo $((1<<3)) $((8>>1)) $((6&3)) $((6|3)) $((6^3))
echo $((1?2:3)) $((0?2:3)) $((1?2:0?3:4))
x=3; echo $((x+1)) $(($x+1)) $((x*x)) $((x))
x=1; echo $((x=5)) $x $((x+=2)) $x $((x++)) $x $((++x)) $x $((x--)) $x $((--x)) $x
x=8; echo $((x/=2)) $((x*=3)) $((x%=5)) $((x<<=2)) $((x>>=1)) $((x&=7)) $((x|=8)) $((x^=1))
echo $((0x10)) $((010)) $((2#101)) $((16#ff)) $((36#z)) $((10#08))
echo $((1,2)) $((x=1,x+1))
unset q; echo $((q+1)) $((q))
x=1+2; echo $((x*2)) $(($x*2))
x=y; y=3; echo $((x+1))
echo $(( (1+(2*3)) )) $(( $(echo 2) + 1 )) $((1+1))$(echo a)
a=(1 2 3); i=1; echo $((a[i]+a[0])) $((a[i]=9)) "${a[1]}"

# A failed expansion ends the script, so these go in subshells.
(echo $((1/0)); echo no) 2>/dev/null; echo "status $?"
(x=$((1%0)); echo no) 2>/dev/null; echo "status $?"
(echo $((1+)); echo no) 2>/dev/null; echo "status $?"
(echo $((08)); echo no) 2>/dev/null; echo "status $?"

# Commands report and go on.
((1+1)); echo $?; ((0)); echo $?; ((x=3)); echo $x
((1/0)) 2>/dev/null; echo $?
let x=1+2; echo $x; let y=0; echo $?; let "z = 4 * 2" w=z+1; echo $z $w
let 1/0 2>/dev/null; echo $?
for ((i=0;i<3;i++)); do echo $i; done
for ((i=0,j=2;i<j;i++,j--)); do echo $i $j; done
i=0; while ((i<2)); do ((i++)); done; echo $i
((i++)) && echo stays; echo $i
declare -i n=2+3; echo $n
