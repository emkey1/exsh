#!/usr/bin/env exsh
# A compound command as a pipeline stage has the pipe for its whole body. Only the first
# command used to get it: the rest wrote to the terminal, and `read` saw no input.
d="${TMPDIR:-/tmp}/exsh_parity_compound.$$"
mkdir -p "$d/top" || exit 1
cd "$d/top" || exit 1

{ echo c; echo d; } | cat
( echo e; echo f ) | cat
echo o | { read x; echo "got=$x"; }
echo o | ( read x; echo "got=$x" )
printf 'a\nb\n' | { read p; read q; echo "$q$p"; }
printf 'a\nb\n' | { head -1; cat; }
{ echo 1; echo 2; } | { read a; read b; echo "$b$a"; }
{ echo x; } | { cat; } | { cat; } | cat
if true; then echo then-1; echo then-2; fi | cat
case x in x) echo case-1; echo case-2;; esac | cat
for i in 1 2 3; do echo "$i"; done | cat
i=0; while [ "$i" -lt 2 ]; do echo "w$i"; i=$((i+1)); done | cat
until true; do :; done | cat
printf 'l1\nl2\n' | while read line; do echo "[$line]"; done
printf 'l1\nl2\n' | for i in 1 2; do read line; echo "$i $line"; done
{ echo mid; } | tr m M | { cat; }
echo in | { cat; echo more; } | wc -l | tr -d ' '
{ echo out; echo err >&2; } 2>&1 | cat
{ ls -d .; pwd >/dev/null; echo builtin; } | cat

# Stages have their own variables and directory.
V=1; echo x | { read V; echo "inside V=$V"; }; echo "V=$V"
V=1; { V=2; } | cat; echo "V=$V"
n=0; printf '1\n2\n' | while read k; do n=$((n+1)); done; echo "n=$n"
{ cd /; } | cat; basename "$PWD"

# Status of the pipeline is its last stage.
{ true; } | { false; }; echo "tail false $?"
{ false; } | { true; }; echo "tail true $?"
echo x | { exit 3; }; echo "exit in tail $?"
{ exit 3; } | cat; echo "exit in head $?"
{ echo a; exit 3; echo b; } | cat; echo "exit in head $?"
! { true; } | { true; }; echo "negated $?"
{ true; } | { exit 4; } && echo no; echo "and-list $?"

# Far more than a pipe holds, with the reader started after the writer.
i=0; while [ "$i" -lt 20000 ]; do echo "line number $i"; i=$((i+1)); done | wc -l | tr -d ' '
{ seq 1 100000; } | wc -l | tr -d ' '
( seq 1 100000 ) | wc -l | tr -d ' '
{ seq 1 100000; } | { wc -l; } | tr -d ' '

# A reader that stops ends the writer.
{ while :; do echo y; done; } | head -2
yes | { head -1; }

# Redirections apply after the pipe, to the body.
{ echo to-file; } > file.out | cat; cat file.out
echo piped | { cat; } > tail.out; cat tail.out
{ cat; } < tail.out | cat
{ { echo no; } > . | cat; echo "bad redirect went on $?"; } 2>/dev/null

# Functions and nested groups in a stage.
f() { echo "f $1"; echo "f $2"; }; { f a b; } | cat
f c d | cat
f e g > fn.out; echo "function redirect $?"; cat fn.out
f h i >> fn.out; cat fn.out
{ f j k > . ; echo "function bad redirect $?"; } 2>/dev/null
s() { ( echo "s $1" ); }; s m | cat; s n > sn.out; cat sn.out
t1() { if ! true; then echo no; fi; }; t1; echo "negated test inside $?"
t2() { ! true; }; t2; echo "negated last $?"; ! t2; echo "negated call $?"
t3() { echo x | cat; return 3; }; t3; echo "pipeline inside $?"; ! t3; echo "negated call $?"
( set -e; t4() { false; echo not-reached; }; t4; echo not-reached ); echo "set -e in a function $?"
g() { { echo g1; echo g2; } | cat; }; g | { cat; }
x=$({ echo sub1; echo sub2; } | { cat; }); echo "$x"
set -- p1 p2; { echo "$1 $#"; shift; echo "$1 $#"; } | cat; echo "$1 $#"

cd /
rm -rf "$d"
